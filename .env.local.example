# --- Dashboard access ---
# REQUIRED once this is deployed anywhere reachable off your own machine. Gates the whole
# app (every page, every /api/* route except the TradingView webhook below, which has its
# own secret) behind HTTP Basic Auth -- your browser prompts once and remembers it after.
# Without this set, there is NO authentication on the trading-control routes (kill switch,
# engine mode incl. enabling LIVE, signal execution) -- anyone who finds the URL can use
# them, and the LIVE confirmation phrase is not a secret (it's hardcoded in this public
# repo). Leave blank only for pure localhost-only development.
DASHBOARD_ACCESS_PASSWORD=

# MetaApi.cloud credentials — see the "MetaApi setup" section in README.md.
# Never commit real values; copy this file to .env.local and fill them in there.
METAAPI_TOKEN=
METAAPI_ACCOUNT_ID=

# Optional: only set this if your broker appends a suffix to symbol names
# (e.g. EURUSD.a, EURUSDm). Leave blank for plain symbols like EURUSD.
MT5_SYMBOL_SUFFIX=

# --- Live account trade execution ---
# By default (Confirmation Mode, ANALYSIS engine mode) nothing trades automatically --
# signals appear on the dashboard as a Trade Proposal with a Buy/Sell button; clicking it
# opens the proposal card, and only an explicit Approve (which re-runs the risk checks
# below and the kill switch fresh) actually places the order on your LIVE account. These
# knobs apply to LIVE (and are the ones a manual approval uses in ANALYSIS/LIVE mode); see
# "Engine mode" below for the separate DEMO_* knobs, and "Confirmation Mode" for
# MANUAL_EXECUTION_MODE/PROPOSAL_TTL_SECONDS. See "Manual execution" in README.md before
# setting METAAPI_TOKEN/METAAPI_ACCOUNT_ID above on a real account.

# Manual-only override: when true, hand-built manual trades remain available after
# account-level risk breakers trip. Automatic and TradingView execution stay protected.
UNRESTRICTED_MANUAL_TRADING=false

# % of account equity risked per trade (position size is computed from this + the
# signal's stop distance, rounded DOWN to the broker's lot step — never up). Deliberately
# conservative -- raise it only once you've validated the strategy against real results
# (see "Backtesting" below) or your own demo-account track record.
RISK_PER_TRADE_PCT=0.25

# Circuit breakers. All are risk-tolerance numbers, not engineering defaults —
# treat these as a conservative starting point to tune, not a final answer.
MAX_CONCURRENT_POSITIONS=3
MAX_DAILY_LOSS_PCT=1
MAX_TRADES_PER_DAY=5

# Revenge-trading cooldown: this many losing deals in a row (any symbol, whole account)
# pauses new execution for COOLDOWN_MINUTES. Resets on a win; re-triggers fresh each time.
MAX_CONSECUTIVE_LOSSES=3
COOLDOWN_MINUTES=30

# --- Confirmation Mode (optional) ---
# Boot default for whether a manual Buy/Sell click opens an approvable Trade Proposal
# ("confirm", the default -- nothing reaches MT5 without an explicit Approve) or shows no
# execute affordance at all ("signal_only" -- the AI only ever surfaces signals). Both
# values are safe; there's no third "skip confirmation" option -- unconditional
# auto-execution is what DEMO/LIVE engine mode is for. Live-adjustable from /dashboard
# afterward (GET/POST /api/confirmation-mode) -- this is only the value a fresh boot/
# redeploy starts from.
MANUAL_EXECUTION_MODE=confirm

# How long (seconds) a Trade Proposal stays approvable after the signal fired. Enforced
# by the execute route itself, not just the dashboard countdown -- see "Confirmation
# Mode" in README.md. Defaults to 120 if unset.
PROPOSAL_TTL_SECONDS=120

# Kill switch: if this file exists, no new LIVE trades are opened (existing positions are
# left alone). Checked fresh on every Buy/Sell click, no restart needed. Path is relative to
# the project root unless absolute. See "Kill switch" in README.md.
KILL_SWITCH_FILE=.trading-paused

# Second kill switch, for platforms with an ephemeral filesystem per deploy (Railway,
# Render, etc.) where a file touched via a one-off shell command won't survive the next
# redeploy. Set to 1/true in the platform's dashboard to block trading from first boot;
# 0/false/unset means not active. This one is GLOBAL -- it blocks LIVE and DEMO trading
# at once, on purpose (see "Engine mode" below). Either switch blocks LIVE trading — both
# are checked.
TRADING_KILL_SWITCH=

# --- Engine mode: ANALYSIS / DEMO / LIVE (optional auto-pilot) ---
# ANALYSIS is the default and the ONLY mode on every fresh boot/restart -- it is never
# read from anywhere persistent, so a restart can never come back up in DEMO or LIVE.
# DEMO and LIVE make the SMC engine auto-execute confirmed signals with no manual click.
# LIVE can ONLY be turned on from the dashboard's engine-mode control (typing a
# confirmation phrase) -- there is no env var that enables it, on purpose.
# See "Engine mode" in README.md.

# Second MetaApi account for DEMO mode -- a SEPARATE MT5 DEMO account, not a paper/dry-run
# simulation. Optional: leave both blank to disable DEMO mode entirely (fails closed --
# never falls back to executing against the live account above).
METAAPI_DEMO_TOKEN=
METAAPI_DEMO_ACCOUNT_ID=

# Per-account risk config for DEMO -- independent of RISK_PER_TRADE_PCT etc. above, which
# apply to LIVE only. Falls back to the same defaults (1% / 3 / 5% / 5) if unset, not to
# whatever LIVE is actually configured to.
DEMO_RISK_PER_TRADE_PCT=
DEMO_MAX_CONCURRENT_POSITIONS=
DEMO_MAX_DAILY_LOSS_PCT=
DEMO_MAX_TRADES_PER_DAY=
DEMO_MAX_CONSECUTIVE_LOSSES=
DEMO_COOLDOWN_MINUTES=

# Kill switch for DEMO specifically, independent of KILL_SWITCH_FILE above (LIVE only) --
# lets you pause demo auto-pilot without touching live, or vice versa.
KILL_SWITCH_FILE_DEMO=.trading-paused-demo

# --- Execution policy (optional) ---
# Boot default for the live-adjustable auto-execute selectivity floor (see the
# "Auto-execute floor" control on /dashboard, backed by GET/POST /api/execution-policy).
# Both are env-overridable specifically so an operator's deliberate tightening survives
# a redeploy instead of silently reverting to the loosest setting every restart -- see
# executionPolicy.ts's own comment. Unset means today's exact default behavior: any
# buy-tier-or-better signal with no extra risk/reward floor.
EXEC_MIN_TIER=buy
EXEC_MIN_RISK_REWARD=0

# --- Backtesting (optional) ---
# Where a completed/failed backtest job history persists (see /backtest,
# backtestRunner.ts) -- a JSON file, not a database, same reasoning as
# DEVICE_STORE_FILE below. A currently RUNNING job lives in memory only and is lost on
# restart, regardless of this setting. Defaults to .backtest-results.json in the
# project root if unset. Backtesting itself needs no separate credentials -- it reuses
# METAAPI_TOKEN/METAAPI_ACCOUNT_ID above (read-only historical candle fetches, fully
# decoupled from the live streaming connection).
BACKTEST_STORE_FILE=

# --- TradingView webhook (optional) ---
# The ONE exception to "nothing trades automatically": if set, POST /api/webhooks/tradingview
# accepts alerts from a TradingView strategy/indicator and places the order immediately,
# no manual click. It still goes through every risk check and both kill switches above —
# no exceptions there. Leave blank to disable the endpoint entirely (it returns 500).
# See "TradingView webhook" in README.md before setting this on a real account.
TRADINGVIEW_WEBHOOK_SECRET=

# Every alert must include a "timestamp" (TradingView's {{timenow}}, UNIX seconds) and is
# rejected if it's older (or further in the future, e.g. clock skew) than this many seconds.
# Protects against a delayed/queued alert firing on market conditions that no longer hold.
# Defaults to 60 if unset.
TRADINGVIEW_MAX_ALERT_AGE_SECONDS=60

# --- Mobile push notifications (optional) ---
# See "Push notifications & JUDE voice (mobile)" in README.md. Without this set, push
# notifications silently no-op (logged, never thrown) -- everything else keeps working.
# Required only if you want a push service access token beyond Expo's default anonymous
# sending; get one from expo.dev (Account settings -> Access tokens) if you enable Expo's
# "enhanced security" push requirement.
EXPO_ACCESS_TOKEN=

# Where registered device push tokens + per-device notification prefs are persisted (a
# JSON file, not a database -- see deviceStore.ts). Must survive restarts, so on a
# platform with an ephemeral filesystem this needs to point at a mounted persistent
# volume. Defaults to .device-tokens.json in the project root if unset.
DEVICE_STORE_FILE=

# --- JUDE voice assistant speech-to-text (optional) ---
# Powers POST /api/voice/transcribe, which the mobile app's voice assistant uses to turn a
# recorded voice command into text via OpenAI's Whisper API. Without this set, that route
# returns 500 -- the rest of the app (including TTS, which is on-device) is unaffected.
OPENAI_API_KEY=

# --- Customer accounts (/account, Stage 1 of a paid API platform -- see README.md) ---
# A completely separate, genuinely public surface from everything above -- has nothing to
# do with your own trading account or the operator dashboard's Basic Auth password.

# Postgres connection string. REQUIRED for /account to work at all. See "Customer
# accounts" in README.md for local dev access (this app has no other database).
DATABASE_URL=

# Google Cloud OAuth Client (console.cloud.google.com -> APIs & Services -> Credentials).
# Without these three, email/password sign-up and sign-in still work fine -- only
# "Continue with Google" is affected (fails with a clear error, doesn't crash anything else).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# Resend (resend.com) -- sends the verification/password-reset emails. Without these,
# accounts still get created/signed in fine, but the emails silently fail to send (logged,
# never thrown) -- see "Customer accounts" in README.md.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=

# Used to build absolute links in those emails (e.g. APP_BASE_URL + /account/verify-email).
# Falls back to the request's own origin if unset, which is fine for a single deployment
# but worth setting explicitly once a real custom domain is in front of this.
APP_BASE_URL=

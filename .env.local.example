# MetaApi.cloud credentials — see the "MetaApi setup" section in README.md.
# Never commit real values; copy this file to .env.local and fill them in there.
METAAPI_TOKEN=
METAAPI_ACCOUNT_ID=

# Optional: only set this if your broker appends a suffix to symbol names
# (e.g. EURUSD.a, EURUSDm). Leave blank for plain symbols like EURUSD.
MT5_SYMBOL_SUFFIX=

# --- Live account trade execution ---
# By default (ANALYSIS engine mode) nothing trades automatically -- signals appear on the
# dashboard as Jude/Omini cards with a Buy/Sell button; clicking it runs the risk checks
# below and the kill switch, then places the order on your LIVE account. These knobs apply
# to LIVE (and are the ones a manual click uses in ANALYSIS/LIVE mode); see "Engine mode"
# below for the separate DEMO_* knobs. See "Manual execution" in README.md before setting
# METAAPI_TOKEN/METAAPI_ACCOUNT_ID above on a real account.

# % of account equity risked per trade (position size is computed from this + the
# signal's stop distance, rounded DOWN to the broker's lot step — never up).
RISK_PER_TRADE_PCT=1

# Circuit breakers. All are risk-tolerance numbers, not engineering defaults —
# treat these as a conservative starting point to tune, not a final answer.
MAX_CONCURRENT_POSITIONS=3
MAX_DAILY_LOSS_PCT=5
MAX_TRADES_PER_DAY=5

# Kill switch: if this file exists, no new LIVE trades are opened (existing positions are
# left alone). Checked fresh on every Buy/Sell click, no restart needed. Path is relative to
# the project root unless absolute. See "Kill switch" in README.md.
KILL_SWITCH_FILE=.trading-paused

# Second kill switch, for platforms with an ephemeral filesystem per deploy (Railway,
# Render, etc.) where a file touched via a one-off shell command won't survive the next
# redeploy. Set to 1/true in the platform's dashboard to block trading from first boot;
# 0/false/unset means not active. This one is GLOBAL -- it blocks LIVE and DEMO trading
# at once, on purpose (see "Engine mode" below). Either switch blocks LIVE trading — both
# are checked.
TRADING_KILL_SWITCH=

# --- Engine mode: ANALYSIS / DEMO / LIVE (optional auto-pilot) ---
# ANALYSIS is the default and the ONLY mode on every fresh boot/restart -- it is never
# read from anywhere persistent, so a restart can never come back up in DEMO or LIVE.
# DEMO and LIVE make the SMC engine auto-execute confirmed signals with no manual click.
# LIVE can ONLY be turned on from the dashboard's engine-mode control (typing a
# confirmation phrase) -- there is no env var that enables it, on purpose.
# See "Engine mode" in README.md.

# Second MetaApi account for DEMO mode -- a SEPARATE MT5 DEMO account, not a paper/dry-run
# simulation. Optional: leave both blank to disable DEMO mode entirely (fails closed --
# never falls back to executing against the live account above).
METAAPI_DEMO_TOKEN=
METAAPI_DEMO_ACCOUNT_ID=

# Per-account risk config for DEMO -- independent of RISK_PER_TRADE_PCT etc. above, which
# apply to LIVE only. Falls back to the same defaults (1% / 3 / 5% / 5) if unset, not to
# whatever LIVE is actually configured to.
DEMO_RISK_PER_TRADE_PCT=
DEMO_MAX_CONCURRENT_POSITIONS=
DEMO_MAX_DAILY_LOSS_PCT=
DEMO_MAX_TRADES_PER_DAY=

# Kill switch for DEMO specifically, independent of KILL_SWITCH_FILE above (LIVE only) --
# lets you pause demo auto-pilot without touching live, or vice versa.
KILL_SWITCH_FILE_DEMO=.trading-paused-demo

# --- TradingView webhook (optional) ---
# The ONE exception to "nothing trades automatically": if set, POST /api/webhooks/tradingview
# accepts alerts from a TradingView strategy/indicator and places the order immediately,
# no manual click. It still goes through every risk check and both kill switches above —
# no exceptions there. Leave blank to disable the endpoint entirely (it returns 500).
# See "TradingView webhook" in README.md before setting this on a real account.
TRADINGVIEW_WEBHOOK_SECRET=

# Every alert must include a "timestamp" (TradingView's {{timenow}}, UNIX seconds) and is
# rejected if it's older (or further in the future, e.g. clock skew) than this many seconds.
# Protects against a delayed/queued alert firing on market conditions that no longer hold.
# Defaults to 60 if unset.
TRADINGVIEW_MAX_ALERT_AGE_SECONDS=60

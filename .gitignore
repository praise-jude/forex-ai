# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template, which is meant to be committed (blank values only)
!.env.local.example

# vercel
.vercel

# trade execution kill switch (runtime state, not source)
.trading-paused

# registered mobile push-notification device tokens (runtime state, not source)
.device-tokens.json

# persisted backtest job history (runtime state, not source)
.backtest-results.json

# trade journal ledger + signal decision funnel (runtime state, not source)
.trade-journal.json

# MetaApi SDK's local runtime cache (account deal/order history), not source
.metaapi/

# Expo/EAS config -- this is a Next.js app, not an Expo project. eas.json/app.json keep
# getting written here by `eas`/`expo` commands run from the wrong cwd (should be
# ../mobile-forex-ai instead) -- ignored so a stray write here can never get committed.
/eas.json
/app.json

# typescript
*.tsbuildinfo
next-env.d.ts
